# Used by `pnpm medusa plugin:db:generate` (generates migrations only; no server is started).
# Copy to .env — never commit .env.
DB_HOST=localhost
# If port 5432 is taken by another PostgreSQL, set POSTGRES_PORT (read by docker compose)
# and DB_PORT to the same free port, for example 5433.
# POSTGRES_PORT=5433
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medusa_voucher
